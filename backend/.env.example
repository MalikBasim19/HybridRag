OPENAI_API_KEY=<your api key>
# Relative storage paths resolve against backend/, independent of working directory.
DATA_DIR=storage
COLLECTION=docling_pdf_collection
FRONTEND_ORIGIN=http://localhost:5173
MAX_FILE_MB=50
MAX_BATCH_FILES=80
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional Qdrant server; blank uses persistent local disk (one API worker only).
QDRANT_URL=
MAX_CONTEXT_CHARS=60000
